# Copy to `.env` or `env.local` and fill in values.
# Load order (later wins): `.env` → `.env.local` → `env.local`

# ── Supabase (required for auth, glossary, support, mood/journal saves) ───────
# Project: OHHF Database — ref rcytzbgwjbftajtykxxr
VITE_SUPABASE_URL=https://rcytzbgwjbftajtykxxr.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-only service role (Settings → API → service_role).
# Any one of these names works; prefer SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_URL=https://rcytzbgwjbftajtykxxr.supabase.co

# ── Companion chat + RAG embeddings ───────────────────────────────────────────
# Prefer OpenRouter OR OpenAI (OpenRouter wins if OPENROUTER_API_KEY is set).
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
# OPENAI_FOLLOWUP_MODEL=gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Care-team personalized question generation ────────────────────────────────
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6
# CARE_TEAM_GENERATED_TTL_DAYS=7

# ── Optional content pipelines (scrape scripts only) ──────────────────────────
# FIRECRAWL_API_KEY=

# ── Optional server ───────────────────────────────────────────────────────────
# PORT=3001

# After keys are set:
#   npm run rag:build    → writes data/knowledge/index.json
#   npm run server:dev   → API on :3001
#   npm run dev          → Vite (proxies /api to :3001)
#   npm run dev:all      → both together
